{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "**/tsconfig*.json",
    "scripts/*/src/**/*.ts",
    "scripts/*/src/**/*.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "MODE",
    "PRO_DOCS",
    "FOR_ALL_SCREEN",
    "ZA_APP_COMMAND"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "deploy": {
      "dependsOn": ["^deploy"],
      "cache": false
    },
    "start": {
      "dependsOn": [],
      "outputs": [],
      "cache": false,
      "persistent": true
    }
  }
}
