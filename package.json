{
  "private": true,
  "name": "anhui-agri-data-plat",
  "version": "1.0.0",
  "scripts": {
    "bootstrap": "pnpm install",
    "start": "gtask start --doc --checkedAll",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 gtask build --doc --checkedAll",
    "publish": "cross-env NODE_OPTIONS=--max-old-space-size=8192 gtask deploy --doc",
    "turbo:start": "turbo run start --parallel",
    "turbo:build": "turbo run build --parallel",
    "turbo:deploy": "turbo run deploy --parallel",
    "prepare": "husky install",
    "manypkg:check": "manypkg check",
    "format": "pnpm run lint:eslint & pnpm run lint:stylelint & pnpm run lint:prettier",
    "lint:eslint": "eslint . --cache --max-warnings 0 --fix",
    "lint:prettier": "prettier --write  \"{packages,apps,configs,scripts}/**/*.{js,json,ts,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --fix "
  },
  "devDependencies": {
    "@config/lint": "workspace:*",
    "@manypkg/cli": "^0.20.0",
    "@scripts/tasks": "workspace:*",
    "@tnnevol/alioss": "^1.0.6",
    "cross-env": "^10.0.0",
    "husky": "^8.0.3",
    "tasksfile": "^5.1.1",
    "turbo": "^2.5.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@10.12.4",
  "volta": {
    "node": "22.14.0"
  }
}